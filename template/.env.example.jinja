# Gundi platform
GUNDI_API_BASE_URL=
GUNDI_OAUTH_CLIENT_ID=
GUNDI_OAUTH_CLIENT_SECRET=
# This connector
INTEGRATION_TYPE_SLUG="{{ integration_type_slug }}"
INTEGRATION_TYPE_NAME="{{ display_name }}"
INTEGRATION_SERVICE_URL=
# Redis (config cache + state store + shared Gundi OAuth token cache)
REDIS_HOST=localhost
REDIS_PORT=6379
# Databases: state 0, config cache 1, token cache 2.
REDIS_TOKEN_CACHE_DB=2
# GUNDI_TOKEN_CACHE_URL overrides the derived redis:// URL (e.g. file:///dir); empty = share tokens in-process only.
